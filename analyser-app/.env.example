# J81 Analyser — copy to .env

# Service
HOST=0.0.0.0
PORT=9000

# Persistence root: SQLite + future cached market data sit here.
DATA_DIR=.

# Optional bearer token. If set, incoming POST /strategies and POST /insights
# must include   Authorization: Bearer <this>   — should match the Researcher's
# LOGGING_APP_API_KEY env var so the two systems agree.
INCOMING_API_KEY=
