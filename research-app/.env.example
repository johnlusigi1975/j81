# Copy to .env and fill in. Never commit the real .env.

# --- LLM (required) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx
# Recommended/default model. Override if you want a cheaper one for high volume,
# e.g. claude-sonnet-4-6 or claude-haiku-4-5.
EXTRACTOR_MODEL=claude-opus-4-7

# --- Where to push survived/extracted strategies (the Logging/Backtest app) ---
# Leave LOGGING_APP_URL empty to fall back to writing strategies to ./out/strategies/
LOGGING_APP_URL=
LOGGING_APP_API_KEY=

# --- Research limits ---
MAX_RESULTS_PER_SOURCE=5
REQUEST_TIMEOUT_SECONDS=30

# --- Optional speech-to-text for TikTok/Instagram audio ---
# Requires `pip install faster-whisper`. If false, those adapters use
# captions/description text only.
ENABLE_WHISPER=false
WHISPER_MODEL=base

# --- Connected-bot trade journal ---
TRADES_DB_PATH=data/trades.db

# --- Service ---
HOST=0.0.0.0
PORT=8001
