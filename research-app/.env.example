# Copy to .env and fill in. Never commit the real .env.

# --- LLM provider ---
# "anthropic" = Claude (paid)  |  "google" = Gemini (generous free tier)
LLM_PROVIDER=anthropic

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx
EXTRACTOR_MODEL=claude-opus-4-7

# --- Google Gemini (used when LLM_PROVIDER=google) ---
# Get a free key at https://aistudio.google.com -> "Get API key"
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Where to push survived/extracted strategies (the Logging/Backtest app) ---
# Leave LOGGING_APP_URL empty to fall back to writing strategies to ./out/strategies/
LOGGING_APP_URL=
LOGGING_APP_API_KEY=

# --- Research limits ---
MAX_RESULTS_PER_SOURCE=5
REQUEST_TIMEOUT_SECONDS=30

# --- Optional source-API credentials (all OPTIONAL; each upgrades one adapter) ---
# Leave any unset; J81 falls back to the keyless scrape path for that source.

# Reddit: create at https://www.reddit.com/prefs/apps (type "web app" or
# "installed app"; redirect uri can be anything for read-only use)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=j81-deriv-researcher/0.3

# YouTube Data API v3: console.cloud.google.com -> enable "YouTube Data API v3" -> create API key
# Daily quota ~10,000 units = ~100 searches/day on the free tier.
YOUTUBE_API_KEY=

# Tavily web search: sign up at https://tavily.com (1000 free credits/month)
TAVILY_API_KEY=

# --- Optional speech-to-text for TikTok/Instagram audio ---
# Requires `pip install faster-whisper`. If false, those adapters use
# captions/description text only.
ENABLE_WHISPER=false
WHISPER_MODEL=base

# --- Connected-bot trade journal ---
TRADES_DB_PATH=data/trades.db

# --- Service ---
HOST=0.0.0.0
PORT=8001
