# J81 Bot — copy to .env, fill in. Never commit the real .env.

# --- Service ---
HOST=0.0.0.0
PORT=9500
DATA_DIR=.

# --- Safety switch ---
# DRY_RUN=true logs every intent as "would_have_traded" without calling
# Deriv's buy endpoint. NEVER set to false until you have:
#   1. Registered a real app on api.deriv.com/dashboard
#   2. Tested extensively in DRY_RUN with multiple decisions
#   3. Decided you accept the regulatory and financial risk per user
DRY_RUN=true

# --- Deriv app registration (you do this at api.deriv.com/dashboard) ---
DERIV_APP_ID=                  # numeric, returned by Deriv when you register your app
DERIV_OAUTH_REDIRECT_URI=http://localhost:9500/oauth/callback
DERIV_MARKUP_PERCENT=2.0       # 0.0 to 5.0; you only see paid markup if Deriv pays it

# --- Token encryption ---
# Generate ONE key and keep it stable; rotating it makes existing tokens unreadable.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BOT_ENCRYPTION_KEY=

# --- Where to read decisions from ---
ANALYSER_URL=http://127.0.0.1:9000

# --- Default per-user risk limits (each user can override) ---
DEFAULT_MAX_STAKE_PER_TRADE=1.0
DEFAULT_MAX_TRADES_PER_DAY=20
DEFAULT_MIN_CONFIDENCE=0.65

# --- Trading loop ---
TRADE_POLL_SECONDS=120         # how often to ask the analyser for decisions
